{
  "name": "pi-web-desktop",
  "private": true,
  "version": "0.3.1-beta.1",
  "description": "Tauri 2 desktop shell for pi-web (bundles Node + pi-web, no prerequisites)",
  "type": "module",
  "scripts": {
    "sidecar": "node scripts/fetch-sidecar.mjs",
    "sidecar:prune": "node scripts/prune-sidecar.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "node scripts/fetch-sidecar.mjs --if-missing && tauri dev",
    "build": "node scripts/fetch-sidecar.mjs --if-missing && tauri build",
    "tauri": "tauri",
    "dist": "bash scripts/make-dist.sh",
    "signing-cert": "bash scripts/create-signing-cert.sh",
    "smoke:app": "node scripts/smoke-app.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
