{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web Desktop",
  "version": "0.2.0",
  "identifier": "com.zilong.piweb.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "title": "Pi Web",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0d12",
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Pi Web in a native window",
    "longDescription": "Desktop shell for pi-web: bundles the Node runtime and the pi-web server, starts it in the background and shows the UI in a native window. Shares ~/.pi/agent with the pi CLI and the browser version.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../sidecar/": "pi-web"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyREYxOTRCRjkxODZGMEYKUldRUGJ4ajVTeG5ma2k3VDBWL2Fva0NxZEtTbVlTWGszQ0o0aURNKzNxRzV6VUl6RkhPWVZackMK",
      "endpoints": [
        "https://github.com/ZilongYang/pi-web-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
